# Copy this file to `.env` (already gitignored) and fill in real values.
# Never commit a real .env — see .gitignore's "Secrets" section.

# Finnhub (https://finnhub.io) — free-tier API key. Powers:
#   - python/interfaces/finnhub_calendar.py -> ReferenceData.is_earnings_today
#   - python/interfaces/finnhub_news.py     -> DataEngine.news_event_checker
#     (per-symbol company news) + general market headlines (informational)
# (see dashboard/engine_bridge.py and scripts/pick_10.py for where these are
# wired in). Leave blank to run without any of the above — everything fails
# safe (earnings/news lookups return False, headlines return an empty list),
# same as before these integrations existed.
FINNHUB_API_KEY=

# SEC EDGAR fair-access policy asks every API consumer to identify itself
# with a contact address (https://www.sec.gov/os/accessing-edgar-data).
# Used by python/data/edgar_client.py for 8-K filing backfills.
# Example: "my-research-project admin@example.com"
SEC_EDGAR_USER_AGENT=

# UHAI parameter suggester (optional) — the Gaussian-Process suggester that
# scripts/self_improve_loop.py can add candidates from, on top of its fixed
# grid. Leave blank and the loop runs the fixed grid alone; that is the
# supported default, not a degraded mode.
#
# Point this at UHAI's Python sidecar. Do NOT use 8082: that is this repo's
# own dashboard port (scripts/start_dashboard.py, README.md), whose API
# includes /api/engine/start and /api/positions/flatten_all. The client
# probes /health to confirm what it is talking to before sending anything,
# and refuses to POST to a service it cannot identify as the sidecar.
#
#   cd <universal-hybrid-ai>/python-svc && PYTHON_SVC_PORT=8092 python main.py
UHAI_PYTHON_SVC_URL=http://127.0.0.1:8092

# Optional shared secret, sent as X-API-Key. Set it only if the sidecar was
# started with one.
SIDECAR_API_KEY=
